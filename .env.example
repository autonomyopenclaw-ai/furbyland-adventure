# Consumer key and secret from the X app (the same app the Queen of Furbies
# poster uses). Never commit real values. This file is only a template.
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here

# Tokens for the adventure account, from `adventure auth`. Not the app secret.
ADVENTURE_ACCESS_TOKEN=your_access_token_here
ADVENTURE_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Handle of the account that should post, without @. The bot checks
# GET /2/users/me and refuses to post if the tokens belong to someone else.
ADVENTURE_USERNAME=your_adventure_handle

# --- optional ---

# most_liked (default) or random. Ties on likes go to the earliest reply.
# ADVENTURE_SELECTION=most_liked

# What to do when nobody has posted a usable reply: nudge (default) or skip.
# ADVENTURE_NO_REPLIES=nudge

# Credit the chosen idea with @handle only when this is true. Default false.
# ADVENTURE_CREDIT_MENTIONS=false

# Split a long chapter into several replies instead of shortening it.
# Each part is still at most 280 characters. Default false.
# ADVENTURE_SPLIT_LONG=false

# ADVENTURE_MAX_CHARS=280
# ADVENTURE_STATE_PATH=state/story.json
# ADVENTURE_PREMISE_PATH=premises/sample.md
# ADVENTURE_TOKEN_PATH=.secrets/adventure-tokens.json

# Language model. auto uses xAI when XAI_API_KEY is set, otherwise OpenAI
# when OPENAI_API_KEY is set, otherwise the built-in templates.
# ADVENTURE_LLM=auto
# XAI_API_KEY=
# XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only change this if api.x.com does not answer. api.twitter.com is the older host.
# X_API_BASE=https://api.x.com
